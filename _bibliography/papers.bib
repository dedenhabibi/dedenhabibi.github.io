@article{alfathimy_indo-pacific_2022,
	title = {The {Indo}-{Pacific} and {Space} {Diplomacy}: {Opportunities} and {Challenges}},
	volume = {20},
	issn = {1477-7622},
	shorttitle = {The {Indo}-{Pacific} and {Space} {Diplomacy}},
	url = {https://doi.org/10.1080/14777622.2022.2081076},
	doi = {10.1080/14777622.2022.2081076},
	abstract = {The Indo-Pacific is a dynamic and competitive geopolitical region. Besides its core maritime nature, there is also outer space politics. There are three important spacefaring states in the region, namely India, Japan, and China, as well as dozens of emerging space countries. Entering the New Space era, however, tense space competition among them is increasing. While space technologies are becoming a significant part of the pursue of their cooperative developmental agenda, so is the use of it for their own national security interests. The problem that arises is whether space diplomacy increases or decreases the stability of the competitive Indo-Pacific region. This paper aims to explore the opportunities and challenges of how space diplomacy can be a means to keep a stable Indo-Pacific by using qualitative approaches and concepts of space diplomacy.},
	number = {1},
	urldate = {2022-11-09},
	journal = {Astropolitics},
	publisher = {Routledge},
	author = {Alfathimy, Deden Habibi Ali and Permatasari, Yunita and Susilawati, Euis and Susanti, Dini and Diana, Shinta R. and Susanto, Joko and Darmawan, Aristyo R.},
	month = jan,
	year = {2022},
	note = {\_eprint: https://doi.org/10.1080/14777622.2022.2081076},
	pages = {43--63},
	annote = {Annotations(12/12/2022, 12:16:00 AM)
“This paper aims to explore the opportunities and challenges of how space diplomacy can be a means to keep a stable Indo-Pacific by using qualitative approaches and concepts of space diplomacy.” (Alfathimy et al., 2022, p. 43)“Figure 1. Three-dimensional model of space diplomacy” (Alfathimy et al., 2022, p. 48)
},
	file = {Alfathimy et al_2022_The Indo-Pacific and Space Diplomacy.pdf:D\:\\References\\Zotero\\storage\\NCINUTGD\\Alfathimy et al. - 2022 - The Indo-Pacific and Space Diplomacy Opportunitie.pdf:application/pdf},
