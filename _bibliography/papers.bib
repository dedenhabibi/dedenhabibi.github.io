@article{alfathimy_teknologi_2015,
	title = {Teknologi {Antariksa} sebagai {Pemampu} {Kunci} {Agenda} {Pembangunan} {Indonesia} {Pasca}-2015},
	volume = {2},
	issn = {2461-0852},
	url = {https://www.researchgate.net/publication/323906539_Teknologi_Antariksa_sebagai_Pemampu_Kunci_Agenda_Pembangunan_Indonesia_Pasca-2015},
	abstract = {Salah satu kebanggaan bangsa Indonesia adalah peluncuran satelit Palapa A-1 pada tahun 1976 yang mampu menyediakan kemampuan telekomunikasi antarpulau di seluruh wilayah nusantara. Namun, sejak saat itu, penguasaan teknologi antariksa di Indonesia belum meningkat secara signifikan. Berbagai hambatan terus dihadapi oleh bangsa Indonesia sehingga penguasaan teknologi tinggi ini sulit berkembang. Meskipun begitu, tantangan pembangunan Indonesia ke depan, apalagi jika merujuk pada agenda pembangunan pasca-2015, tidak lagi bisa menawar pentingnya penguasaan teknologi antariksa di masa depan. Walaupun teknologi antariksa ini berbiaya dan berisiko tinggi, tantangan fisik Indonesia sebagai negara kepulauan serta peluang yang hadir di tingkat internasional terkait pemanfaatan teknologi antariksa merupakan momentum yang perlu dimanfaatkan dalam menyusun agenda pembangunan Indonesia pasca-2015.},
	journal = {Jurnal Mahasiswa Hubungan Internasional Esensi},
	author = {Alfathimy, Deden Habibi Ali},
	month = nov,
	year = {2015},
	pages = {37--44},
	file = {Alfathimy_2015_Teknologi Antariksa sebagai Pemampu Kunci Agenda Pembangunan Indonesia.pdf:D\:\\References\\Zotero\\storage\\B2M949FC\\Alfathimy_2015_Teknologi Antariksa sebagai Pemampu Kunci Agenda Pembangunan Indonesia.pdf:application/pdf},
}

@article{alfathimy_wawasan_2023,
	title = {Wawasan {Nusantara} and space resilience in {Indonesia}},
	volume = {2941},
	copyright = {CC0 1.0 Universal Public Domain Dedication},
	issn = {0094-243X},
	url = {https://doi.org/10.1063/5.0181401},
	doi = {10.1063/5.0181401},
	abstract = {Security, safety, and sustainability are concepts that have long been discussed in space governance issues to prevent any damage. However, the challenges of an increasingly congested and complicated space environment make the functional loss and even the space assets themselves bigger and need to be mitigated. The resilience approach was then developed by several countries in response to these challenges. Indonesia also faces the same challenge even though its space assets are still relatively few. Nevertheless, the application of the concept of resilience in its space activities has not yet been elaborated on in its own space policy as well as in the discourse of resilience policy in general. Therefore, this paper discusses the development of the concept of space resilience in the literature and reflects it into policies and practices in Indonesia. The study method used is desk research. In the end, this paper finds that the reinvigoration of Wawasan Nusatara concept as Indonesian geopolitics could be the focal point for introducing space resilience.},
	number = {1},
	urldate = {2024-01-07},
	journal = {AIP Conference Proceedings},
	author = {Alfathimy, Deden Habibi Ali and Ras, Abdul Rivai and Nurlambang, Triarko},
	month = dec,
	year = {2023},
	pages = {040027},
	file = {Snapshot:D\:\\References\\Zotero\\storage\\PWUDBWVU\\Wawasan-Nusantara-and-space-resilience-in.html:text/html},
}

