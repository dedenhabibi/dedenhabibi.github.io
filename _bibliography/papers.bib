@article{alfathimy_ketimpangan_2019,
	title = {Ketimpangan {Pemanfaatan} {Orbit} {Geostasioner} ({GSO}) dalam {Lingkungan} {Sistem} {Dunia}},
	volume = {4},
	copyright = {All rights reserved},
	issn = {2503-443X},
	url = {http://intermesticjournal.fisip.unpad.ac.id/index.php/intermestic/article/view/154},
	doi = {10.24198/intermestic.v4n1.6},
	abstract = {Artikel ini bertujuan untuk menganalisis ketimpangan pemanfaatan orbit geostasioner (GSO) dalam lingkungan sistem dunia dengan menggunakan Teori Sistem Dunia secara kualitatif-deskriptif. Tingginya tingkat kesulitan penguasaan teknologi dalam pemanfaatan GSO membuat negara-negara yang tidak memiliki kemampuan finansial dan kapabilitas keantariksaan suka tak suka menggunakan produk-produk satelit GSO dari negara-negara maju. Berdasarkan pendekatan historis dan konseptual dari Teori Sistem Dunia, hasil analisis menunjukkan bahwa ketimpangan pemanfaatan GSO diakibatkan oleh dan berdampak pada persistensi maupun revisi hubungan antarnegara dalam lingkungan sistem dunia. Perjuangan kelas merupakan tindakan yang dilakukan secara alami oleh negara-negara semi-pinggiran dan pinggiran, termasuk Indonesia, untuk merevisi lingkungan sistem dunia dengan cara meningkatkan kemandirian dan mempromosikan pengaturan yang lebih adil dalam pemanfaatan GSO.},
	number = {1},
	urldate = {2019-12-04},
	journal = {Intermestic: Journal of International Studies},
	author = {Alfathimy, Deden Habibi Ali and Sudjatmiko, Totok and Susilawati, Euis},
	month = nov,
	year = {2019},
	note = {Number: 1},
	pages = {88},
	file = {Alfathimy et al_2019_Ketimpangan Pemanfaatan Orbit Geostasioner (GSO) dalam Lingkungan Sistem Dunia.pdf:D\:\\References\\Zotero\\storage\\4EXIEYSP\\Alfathimy et al_2019_Ketimpangan Pemanfaatan Orbit Geostasioner (GSO) dalam Lingkungan Sistem Dunia.pdf:application/pdf},
}

